# =============================================================================
# Senja-CMS — env example (copy to `.env`)
# =============================================================================

# -----------------------------------------------------------------------------
# Lokal
# -----------------------------------------------------------------------------
# Port internal container Next.js
PORT=3000

# Port host yang dipublish docker-compose (hindari bentrok dengan stack lain).
HOST_PORT=13052

# Base URL Senja-BE yang dipakai browser (auth, inbox, konten).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Origin yang diizinkan memanggil endpoint kontak CMS (legacy; kosongkan bila
# endpoint kontak sudah tidak dipakai).
CONTACT_ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# Produksi (contoh)
# -----------------------------------------------------------------------------
# PORT=3000
# HOST_PORT=13052
# NEXT_PUBLIC_API_URL=https://api.senja.sabirudigital.id/api/v1
# CONTACT_ALLOWED_ORIGIN=https://senja.sabirudigital.id
