# Port the Next.js server listens on inside the container
PORT=3000

# Host port to publish (checked against `docker ps` on 2026-09-14 to avoid
# clashing with other stacks already running on this host: 13050, 13051,
# 3050, 3010, 8080-8090, 17343-17381, 16379-16380, 55432, etc.)
HOST_PORT=13052

# Origin allowed to call /api/contact-inquiries (CORS). Set this to the
# public URL of the site that submits the contact form, e.g. your
# Cloudflare tunnel domain. Leave empty to only allow http://localhost:*.
CONTACT_ALLOWED_ORIGIN=
